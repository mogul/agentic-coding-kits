#!/usr/bin/env python3
"""Provision an isolated temporary test environment; no CI/global dependency changes."""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

kit = Path(__file__).resolve().parents[1]
if os.environ.get("RUN_CLAUDE_LIVE") == "1":
    raise SystemExit("scripts/test is offline-only; run opt-in live tests explicitly from the configured environment")
with tempfile.TemporaryDirectory(prefix="claude-kit-test-") as work:
    python = Path(work) / "venv/bin/python"
    if shutil.which("uv"):
        subprocess.run(["uv", "venv", "--python", sys.executable, "--seed", str(python.parents[1])], check=True)
    else:
        subprocess.run([sys.executable, "-m", "venv", str(python.parents[1])], check=True)
    subprocess.run(
        [
            str(python),
            "-m",
            "pip",
            "install",
            "--isolated",
            "--require-hashes",
            "--only-binary=:all:",
            "--index-url",
            "https://pypi.org/simple",
            "-r",
            str(kit / "files/home/claude-code/requirements.lock"),
        ],
        check=True,
    )
    subprocess.run(
        [
            str(python),
            "-m",
            "pip",
            "install",
            "--isolated",
            "--only-binary=:all:",
            "--index-url",
            "https://pypi.org/simple",
            "--require-hashes",
            "-r",
            str(kit / "tests/requirements.lock"),
        ],
        check=True,
    )
    sys.exit(subprocess.run([str(python), "-m", "pytest", str(kit / "tests"), "-q"]).returncode)
