#!/usr/bin/env python3
"""Vendor selected skills from mattpocock/skills into the personal kit at a pinned commit.

The skills are Matt Pocock's work (https://github.com/mattpocock/skills, MIT,
Copyright (c) 2026 Matt Pocock). This tool copies them; it does not rewrite them
beyond the single documented rename. Provenance, the licence notices and the list of
local differences are in NOTICE and docs/vendored-skills.md.

Writes copies under files/ (verbatim except the one documented rename below),
regenerates the vendored block of spec.yaml's files[] list, and records the
pinned commit and a sha256 per shipped file in vendor/mattpocock-skills.json.

This is an authoring tool. It runs on the host, is never shipped into the guest,
and is the only code in this kit that uses the network.

  vendor-pocock-skills                 re-vendor the commit pinned in the lock file
  vendor-pocock-skills --sha SHA       move the pin to SHA (a full 40-character commit)
  vendor-pocock-skills --check         fail if a shipped file differs from, or is missing against,
                                       a fresh vendoring (scripts/verify also flags extra files)
  vendor-pocock-skills --tarball FILE  read a downloaded archive instead of fetching

The rename: upstream's code-review skill is installed as pocock-code-review
because the playbook kit ships a different skill named code-review into the same
directory. Every reference to it inside the vendored skills is rewritten, and the
count per file is pinned below so an upstream change fails loudly instead of
leaving a caller pointing at the wrong skill.
"""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import sys
import tarfile
import urllib.request
from pathlib import Path

UPSTREAM = "mattpocock/skills"
ARCHIVE_URL = f"https://codeload.github.com/{UPSTREAM}/tar.gz/{{sha}}"
SHA_RE = re.compile(r"[0-9a-f]{40}")
VERSION_RE = re.compile(r"[0-9A-Za-z][0-9A-Za-z.+-]{0,39}")  # text from upstream that reaches a doc
SAFE_PATH = re.compile(r"[A-Za-z0-9._/-]+")  # the hybrid/v1 files[].path charset
MAX_TOTAL_BYTES = 8 * 1024 * 1024
MAX_ARCHIVE_BYTES = 20 * 1024 * 1024
MAX_FILE_BYTES = 1024 * 1024
FETCH_TIMEOUT = 60

KIT = Path(__file__).resolve().parents[1]
SKILLS_DIR = "files/home/.agents/skills"
LICENSE_PATH = "files/home/.agents/licenses/mattpocock-skills-LICENSE"
LOCK_PATH = "vendor/mattpocock-skills.json"
DOC_PATH = "docs/vendored-skills.md"
DOC_BEGIN = "<!-- BEGIN generated:local-differences (scripts/vendor-pocock-skills; do not edit) -->"
DOC_END = "<!-- END generated:local-differences -->"
PLUGIN_MANIFEST = ".claude-plugin/plugin.json"
SPEC_PATH = "spec.yaml"
BEGIN_MARK = "  # BEGIN vendored:mattpocock-skills (generated by scripts/vendor-pocock-skills; do not edit)"
END_MARK = "  # END vendored:mattpocock-skills"

SKILLS = {
    name: f"skills/engineering/{name}"
    for name in (
        "ask-matt",
        "code-review",
        "codebase-design",
        "diagnosing-bugs",
        "domain-modeling",
        "grill-with-docs",
        "implement",
        "implement-spec",
        "improve-codebase-architecture",
        "pr",
        "prototype",
        "research",
        "retro",
        "setup-matt-pocock-skills",
        "tdd",
        "to-spec",
        "to-tickets",
        "triage",
        "wayfinder",
        "wizard",
    )
}
for name in ("grill-me", "grilling", "handoff", "teach", "to-questionnaire", "wait-what", "writing-for-agents"):
    SKILLS[name] = f"skills/productivity/{name}"

OLD_NAME = "code-review"
NEW_NAME = "pocock-code-review"
NAME_TOKEN = re.compile(r"(?<![A-Za-z0-9_-])" + re.escape(OLD_NAME) + r"(?![A-Za-z0-9_-])")
# Expected number of references to the renamed skill, per shipped file. A file
# that is not listed must contain none.
TOKEN_COUNTS = {
    "pocock-code-review/SKILL.md": 1,
    "ask-matt/SKILL.md": 4,
    "implement/SKILL.md": 1,
    "implement-spec/SKILL.md": 1,
    "tdd/SKILL.md": 1,
}
LITERAL_PATCHES = {
    "pocock-code-review/agents/openai.yaml": ('display_name: "Code Review"', 'display_name: "Pocock Code Review"'),
}


ATTRIBUTION = {
    "author": "Matt Pocock",
    "source": f"https://github.com/{UPSTREAM}",
    "copyright": "Copyright (c) 2026 Matt Pocock",
    "licenseFile": "files/home/.agents/licenses/mattpocock-skills-LICENSE",
    "notice": "NOTICE",
}


# Material inside the vendored skills that comes from a third party. Not fetched by
# this script: the licence file is committed by hand and scripts/verify checks its hash.
THIRD_PARTY = [
    {
        "skill": "pr",
        "work": "show-me",
        "author": "Dex Horthy",
        "organisation": "HumanLayer",
        "source": "https://github.com/humanlayer/skills/tree/4d69d20f6e9b57b4fcf0d501ccfb1be961f0f329/plugins/show-me",
        "license": "MIT",
        "copyright": "Copyright (c) 2026 HumanLayer",
        "licenseFile": "files/home/.agents/licenses/humanlayer-skills-LICENSE",
        "licenseSha256": "5f13c18ea00ea5c1384f41745feeca774079164f7f59a92e4ac0899ad217b26f",
    }
]


class VendorError(Exception):
    pass


def local_changes() -> list[dict[str, str]]:
    """Every way a shipped file differs from upstream, for the lock and for docs/vendored-skills.md."""
    changes = [
        {
            "file": f"{NEW_NAME}/",
            "change": f"upstream skills/engineering/{OLD_NAME}/ is installed under the name {NEW_NAME}",
        }
    ]
    for path, count in sorted(TOKEN_COUNTS.items()):
        noun = "reference" if count == 1 else "references"
        changes.append({"file": path, "change": f"{count} {noun} to {OLD_NAME} rewritten to {NEW_NAME}"})
    for path, (old, new) in sorted(LITERAL_PATCHES.items()):
        changes.append({"file": path, "change": f"{old} -> {new}"})
    return changes


def guest_path(upstream_rel: str) -> str | None:
    for name, upstream_dir in SKILLS.items():
        if upstream_rel.startswith(upstream_dir + "/"):
            guest_name = NEW_NAME if name == OLD_NAME else name
            return guest_name + upstream_rel[len(upstream_dir) :]
    return None


def read_text(tar: tarfile.TarFile, member: tarfile.TarInfo) -> str:
    if member.size > MAX_FILE_BYTES:
        raise VendorError(f"{member.name}: larger than {MAX_FILE_BYTES} bytes")
    handle = tar.extractfile(member)
    if handle is None:
        raise VendorError(f"{member.name}: unreadable")
    raw = handle.read()
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise VendorError(f"{member.name}: not UTF-8 text; kit files must be text") from None
    if "\x00" in text:
        raise VendorError(f"{member.name}: contains a NUL byte; kit files must be text")
    return text


def read_archive(data: bytes, sha: str) -> tuple[dict[str, str], str, dict]:
    root = f"skills-{sha}/"
    found: dict[str, str] = {}
    license_text = None
    manifest_text = None
    total = 0
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        for member in tar.getmembers():
            if member.name == root.rstrip("/") and member.isdir():
                continue
            if not member.name.startswith(root):
                raise VendorError(f"archive entry outside {root}: {member.name}")
            rel = member.name[len(root) :]
            parts = rel.split("/")
            if rel.startswith("/") or ".." in parts:
                raise VendorError(f"unsafe archive path: {member.name}")
            target = guest_path(rel)
            if rel == PLUGIN_MANIFEST and member.isreg():
                manifest_text = read_text(tar, member)
                continue
            if rel != "LICENSE" and target is None:
                continue
            if member.isdir():
                continue
            if not member.isreg():
                raise VendorError(f"{member.name}: not a regular file (links and devices are refused)")
            if not SAFE_PATH.fullmatch(rel) or any(part in ("", ".", "..") for part in parts):
                raise VendorError(f"unsafe file name in the archive: {rel!r}")
            total += member.size
            if total > MAX_TOTAL_BYTES:
                raise VendorError(f"shipped files exceed {MAX_TOTAL_BYTES} bytes in total")
            text = read_text(tar, member)
            if rel == "LICENSE":
                license_text = text
            else:
                found[target] = text
    if license_text is None:
        raise VendorError("upstream LICENSE not found in the archive")
    if manifest_text is None:
        raise VendorError(f"upstream {PLUGIN_MANIFEST} not found in the archive")
    return found, license_text, promoted_manifest(manifest_text)


def promoted_manifest(text: str) -> dict:
    """The skills upstream promotes and its release version, from its plugin manifest."""
    manifest = json.loads(text)
    if not isinstance(manifest, dict):
        raise VendorError(f"{PLUGIN_MANIFEST}: expected a JSON object")
    listed = manifest.get("skills")
    if not isinstance(listed, list) or not all(isinstance(item, str) for item in listed):
        raise VendorError(f"{PLUGIN_MANIFEST}: expected a skills list")
    names = {item.rstrip("/").rsplit("/", 1)[-1] for item in listed}
    version = manifest.get("version")
    if not (isinstance(version, str) and VERSION_RE.fullmatch(version)):
        version = "unknown"
    return {"names": names, "version": version}


def check_promoted(promoted: dict) -> None:
    """Fail when upstream's promoted set no longer equals what this kit ships."""
    shipped = set(SKILLS)
    added, removed = sorted(promoted["names"] - shipped), sorted(shipped - promoted["names"])
    if added or removed:
        raise VendorError(
            "upstream's promoted skills changed; decide on each, then edit SKILLS"
            f" (newly promoted: {added or 'none'}; no longer promoted: {removed or 'none'})"
        )


def apply_patches(files: dict[str, str]) -> dict[str, str]:
    patched = {}
    for path, text in sorted(files.items()):
        expected = TOKEN_COUNTS.get(path, 0)
        actual = len(NAME_TOKEN.findall(text))
        if actual != expected:
            raise VendorError(f"{path}: expected {expected} references to {OLD_NAME}, found {actual}")
        text = NAME_TOKEN.sub(NEW_NAME, text)
        if path in LITERAL_PATCHES:
            old, new = LITERAL_PATCHES[path]
            if text.count(old) != 1:
                raise VendorError(f"{path}: expected exactly one {old!r}")
            text = text.replace(old, new)
        patched[path] = text
    for path in list(TOKEN_COUNTS) + list(LITERAL_PATCHES):
        if path not in files:
            raise VendorError(f"patched file missing from the archive: {path}")
    for name in SKILLS:
        guest_name = NEW_NAME if name == OLD_NAME else name
        if f"{guest_name}/SKILL.md" not in files:
            raise VendorError(f"{name}: SKILL.md missing from the archive")
    return patched


def spec_block(paths: list[str]) -> str:
    lines = [BEGIN_MARK]
    for path in paths:
        lines += [f"  - path: /home/agent/{path[len('files/home/') :]}", '    mode: "0644"', f"    source: {path}"]
    lines.append(END_MARK)
    return "\n".join(lines)


def render_spec(current: str, paths: list[str]) -> str:
    begin, end = current.find(BEGIN_MARK), current.find(END_MARK)
    if begin < 0 or end < begin:
        raise VendorError(f"{SPEC_PATH}: vendored block markers not found")
    return current[:begin] + spec_block(paths) + current[end + len(END_MARK) :]


def render_doc(current: str, lock: dict) -> str:
    begin, end = current.find(DOC_BEGIN), current.find(DOC_END)
    if begin < 0 or end < begin:
        raise VendorError(f"{DOC_PATH}: generated block markers not found")
    rows = ["| Shipped file | What differs from upstream |", "| --- | --- |"]
    rows += [f"| `{c['file']}` | {c['change'].replace('|', chr(92) + '|')} |" for c in lock["localChanges"]]
    third = [
        f"- `{t['skill']}`: adapted from `{t['work']}` by {t['author']} ({t['organisation']}), {t['license']},"
        f" {t['copyright']}; notice at `{t['licenseFile']}`; source {t['source']}"
        for t in lock["thirdParty"]
    ]
    facts = [
        f"- Upstream: {lock['attribution']['source']} at commit `{lock['ref']}`, release `{lock['upstreamVersion']}`"
        f" ({lock['attribution']['copyright']}, {lock['license']}).",
        f"- Shipped: {len(lock['skills'])} skills, {len(lock['files'])} files (the licence included).",
        "",
        "Third-party material inside those skills:",
        *third,
        "",
    ]
    block = "\n".join([DOC_BEGIN, *facts, *rows, DOC_END])
    return current[:begin] + block + current[end + len(DOC_END) :]


def sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def build_plan(kit: Path, data: bytes, sha: str) -> dict[str, str]:
    check_third_party(kit)
    files, license_text, promoted = read_archive(data, sha)
    check_promoted(promoted)
    files = apply_patches(files)
    plan = {f"{SKILLS_DIR}/{path}": text for path, text in files.items()}
    plan[LICENSE_PATH] = license_text
    lock = {
        "upstream": UPSTREAM,
        "ref": sha,
        "license": "MIT",
        "upstreamVersion": promoted["version"],
        "attribution": ATTRIBUTION,
        "thirdParty": THIRD_PARTY,
        "skills": {(NEW_NAME if n == OLD_NAME else n): p for n, p in sorted(SKILLS.items())},
        "tokenRenames": {"from": OLD_NAME, "to": NEW_NAME, "counts": TOKEN_COUNTS},
        "localChanges": local_changes(),
        "files": {path: sha256(text) for path, text in sorted(plan.items())},
    }
    plan[LOCK_PATH] = json.dumps(lock, indent=2, sort_keys=True) + "\n"
    current_spec = (kit / SPEC_PATH).read_text(encoding="utf-8")
    lock_doc = json.loads(plan[LOCK_PATH])
    plan[DOC_PATH] = render_doc((kit / DOC_PATH).read_text(encoding="utf-8"), lock_doc)
    plan[SPEC_PATH] = render_spec(current_spec, sorted(p for p in plan if p.startswith("files/")))
    return plan


def check_third_party(kit: Path) -> None:
    """The hand-committed third-party licence files must exist and match their pinned hash."""
    for item in THIRD_PARTY:
        path = kit / item["licenseFile"]
        if not path.is_file():
            raise VendorError(f"missing third-party licence: {item['licenseFile']}")
        if hashlib.sha256(path.read_bytes()).hexdigest() != item["licenseSha256"]:
            raise VendorError(f"{item['licenseFile']}: does not match the pinned sha256")


def previous_files(kit: Path) -> set[str]:
    """Paths the last vendoring wrote, from the lock file.

    The lock arrives through git, so it is untrusted: anything that is not a plain
    relative path under files/ is ignored, and what remains must resolve inside the kit.
    """
    lock = kit / LOCK_PATH
    if not lock.is_file():
        return set()
    document = json.loads(lock.read_text(encoding="utf-8"))
    listed = document.get("files") if isinstance(document, dict) else None
    if not isinstance(listed, dict):
        raise VendorError(f"{LOCK_PATH}: expected an object with a files object")
    base = kit.resolve()
    safe = set()
    for path in listed:
        if not isinstance(path, str):
            continue
        parts = Path(path).parts
        if Path(path).is_absolute() or ".." in parts or not path.startswith("files/"):
            continue
        if (base / path).resolve().is_relative_to(base):
            safe.add(path)
    return safe


def compare(kit: Path, plan: dict[str, str]) -> list[str]:
    problems = []
    for path, text in sorted(plan.items()):
        target = kit / path
        if not target.is_file():
            problems.append(f"missing: {path}")
        elif target.read_bytes() != text.encode("utf-8"):
            problems.append(f"differs: {path}")
    problems += [f"stale: {path}" for path in sorted(previous_files(kit) - set(plan)) if (kit / path).exists()]
    return problems


def write_plan(kit: Path, plan: dict[str, str]) -> None:
    for path in sorted(previous_files(kit) - set(plan)):
        (kit / path).unlink(missing_ok=True)
        parent = (kit / path).parent
        while parent != kit / SKILLS_DIR and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
    for path in plan:
        probe = kit
        for part in Path(path).parts:
            probe = probe / part
            if probe.is_symlink():
                raise VendorError(f"refusing to write through a symlink: {probe.relative_to(kit)}")
    for path, text in plan.items():
        target = kit / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(text.encode("utf-8"))
        target.chmod(0o644)


def fetch(sha: str) -> bytes:
    url = ARCHIVE_URL.format(sha=sha)
    with urllib.request.urlopen(url, timeout=FETCH_TIMEOUT) as response:  # noqa: S310 (https constant)
        data = response.read(MAX_ARCHIVE_BYTES + 1)
    if len(data) > MAX_ARCHIVE_BYTES:
        raise VendorError(f"archive larger than {MAX_ARCHIVE_BYTES} bytes")
    return data


def resolve_sha(kit: Path, requested: str | None) -> str:
    if requested is None:
        lock = kit / LOCK_PATH
        if not lock.is_file():
            raise VendorError("no lock file yet; pass --sha with a full commit")
        requested = json.loads(lock.read_text(encoding="utf-8"))["ref"]
    if not SHA_RE.fullmatch(requested):
        raise VendorError("the pin must be a full 40-character lowercase commit SHA")
    return requested


def run(kit: Path, args: argparse.Namespace) -> int:
    sha = resolve_sha(kit, args.sha)
    data = args.tarball.read_bytes() if args.tarball else fetch(sha)
    plan = build_plan(kit, data, sha)
    if args.check:
        problems = compare(kit, plan)
        for problem in problems:
            print(problem, file=sys.stderr)
        print(f"{'differs' if problems else 'matches'} upstream {sha}")
        return 1 if problems else 0
    write_plan(kit, plan)
    print(f"vendored {len(json.loads(plan[LOCK_PATH])['files'])} files from {sha}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--sha", help="full commit SHA to pin (default: the lock file's)")
    parser.add_argument(
        "--check", action="store_true", help="compare only; change nothing (extra files: see scripts/verify)"
    )
    parser.add_argument("--tarball", type=Path, help="read this .tar.gz instead of fetching")
    parser.add_argument("--kit", type=Path, default=KIT, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    try:
        return run(args.kit.resolve(), args)
    except (VendorError, OSError, tarfile.TarError, json.JSONDecodeError, KeyError) as error:
        print(f"vendor-pocock-skills: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
