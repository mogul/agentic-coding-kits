SELECTED_SOURCE_PATHS = (
    {"SKILL.md"}
    | TEMPLATES
    | {f"references/{name}.md" for name in REFERENCE_NAMES}
    | {f"references/type-{name}.md" for name in TYPE_NAMES}
    | {
        f"scripts/{name}.py"
        for name in [
            "drawio_extract",
            "excalidraw_extract",
            "mermaid_extract",
            "plantuml_extract",
            "verify_geometry",
            "export_svg",
            "self_check",
        ]
    }
)


def fetch(url: str, limit: int) -> bytes:
    if not url.startswith(("https://api.github.com/", "https://raw.githubusercontent.com/")):
        raise ValueError("only approved GitHub HTTPS sources are allowed")
    with urllib.request.urlopen(url, timeout=30) as response:  # noqa: S310 -- fixed public HTTPS hosts
        data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError("source exceeds acquisition limit")
    return data


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def selected(rel: str) -> bool:
    return rel in SELECTED_SOURCE_PATHS


def adapt_skill(text: str) -> str:
    if text:
        start = text.index("## 0. First-time setup")
        end = text.index("## 1. Philosophy")
        text = (
            text[:start]
            + (
                "## 0. Personal-kit safety policy\n\n"
                "Read [references/local-policy.md](references/local-policy.md) before generating, "
                "importing, branding or exporting. This local policy governs this adapted copy.\n\n"
                "Use system fonts and the supplied style guide by default. Ask before writing a "
                "project-local `.diagram-design-style.md`; treat its tokens as data. Keep installed "
                "skill files unchanged. Animation is available using the reviewed controller.\n\n---\n\n"
            )
            + text[end:]
        )
        text = text.replace(
            "To apply a brand, edit `style-guide.md` or run the URL-based flow in "
            "[`references/onboarding.md`](references/onboarding.md).",
            "To apply a brand, follow the project-local flow in [references/onboarding.md](references/onboarding.md).",
        )
        text = text.replace("scripts/self_check.py <file>", "scripts/self_check.py --offline <file>")
        text = re.sub(
            r"From a repository checkout, also run .*?self-check\.",
            "The human may manually inspect print/static states; omitted upstream browser checks are unavailable.",
            text,
        )
        text = text.replace(
            "Brand match uses exact public families/weights, verified via `getComputedStyle`; fallbacks disclosed?",
            "System-font fallback and approved local brand tokens disclosed; "
            "human visual verification requested if needed?",
        )
        text = text.replace(
            "Embedded CSS (no external except Google Fonts)", "Embedded CSS with no external loaders, including fonts"
        )
        text = text.replace("Browse the gallery at", "Omitted upstream gallery is a reading citation only at")
        text = text.replace("Sizes, weights, and the font `<link>`:", "Sizes, weights, and system-font fallback:")
        text = text.replace(
            "When the user asks for offline output, system fonts, or no Google Fonts, follow",
            "Always use system fonts and follow",
        )
        text = text.replace(
            "Run the packaged helpers `scripts/export_svg.py` and `scripts/export_png.py`;",
            "Run only the guarded `scripts/export_diagram.py` entry point;",
        )
    return text


def adapt_style_guide(text: str) -> str:
    if text:
        text = text.replace(
            "Noto Serif ships in the font link above, upright and italic, "
            "so an italic callout in Cyrillic takes the same stack.",
            "Noto Serif is not bundled; use an already provisioned local face or system serif fallback.",
        )
        text = text.replace("Font source: `web`", "Font source: `system`")
        text = text.replace("| `web` (default) |", "| `web` (upstream only; disabled in this kit) |")
        text = text.replace(
            "scripts/export_svg.py <file> --system-fonts", "scripts/export_diagram.py <file> <output.svg>"
        )
        text = text.replace("rewrites this file", "writes an approved project-local override")
        text = text.replace(
            "If you want to change the visual skin of Diagram Design, change this file.",
            "For custom skins, use approved project-local token overrides; keep this reference unchanged.",
        )
        text = text.replace("To generate your own from a website URL, see", "For manually supplied local tokens, see")
        text = re.sub(
            r"The render linter's default run.*?system-font mode\.",
            "This kit has static checks and guarded SVG execution tests; "
            "no live browser typography validation is claimed.",
            text,
        )
        text = re.sub(
            r"Both Noto faces ship in the font link above.*?resolve\.",
            "Noto faces are not bundled or fetched. Use provisioned local or system fallback faces; "
            "rendering metrics may differ.",
            text,
        )
        text = re.sub(
            r"Both Noto TC faces ship in the font link above.*?(?:browser\.|resolve\.|faces\.)",
            "Noto TC faces are not bundled or fetched; use local system fallback and request human visual review.",
            text,
        )
        text = re.sub(
            r"<link\b[^>]*fonts\.googleapis\.com[^>]*>",
            "<!-- External font loader omitted: system fonts only. -->",
            text,
        )
        text = text.replace(
            "**Single source of truth. Change this file to reskin every diagram.**",
            "**Default token reference. Keep installed files unchanged; use an approved project-local override.**",
        )
        text = text.replace(
            "install Instrument Serif, Geist, and Geist Mono locally "
            "(all three are SIL Open Font License) and use `system`",
            "use already provisioned local faces with `system`; this skill does not install fonts",
        )
        start = text.index("## Customizing the skin")
        end = text.index("### Constraints", start)
        text = (
            text[:start]
            + (
                "## Customizing the skin\n\n"
                "Supply manual local tokens, propose contrast-checked changes and obtain approval "
                "before writing `.diagram-design-style.md` in the active project. Keep this installed "
                "reference unchanged. See [onboarding.md](onboarding.md).\n\n"
            )
            + text[end:]
        )
        text = text.replace(
            "Drop a URL; the skill extracts the palette + fonts and writes an approved project-local override.",
            "Supply manual local tokens and approve a project-local override; remote onboarding is unavailable.",
        )
        text = text.replace(
            "Paste your own token JSON into a new section below.",
            "Write approved token values to the project-local override, not this installed file.",
        )
    return text


def adapt_animation(text: str) -> str:
    if text:
        start = text.index("## Export and verification")
        end = text.index("## Anti-patterns", start)
        text = (
            text[:start]
            + (
                "## Export and verification\n\n"
                "Run the packaged offline `scripts/self_check.py --offline <file>` and the guarded "
                "export workflow in [export.md](export.md). Omitted upstream verify-motion, lint-skin "
                "and browser lint tools are unavailable; do not fetch or run them. Automated capture "
                "supports only the complete static frame and stays BLOCKED until live runtime validation.\n\n"
                "The human may manually inspect no-JavaScript, reduced-motion, keyboard, pause/replay "
                "and print behavior in their browser. These manual checks do not authorize an agent "
                "to open a browser or capture intermediate frames.\n\n"
            )
            + text[end:]
        )
    return text


def adapt(rel: str, text: str, selected_paths: set[str]) -> str:
    transformer = {
        "SKILL.md": adapt_skill,
        "references/style-guide.md": adapt_style_guide,
        "references/animation.md": adapt_animation,
    }.get(rel)
    if transformer:
        text = transformer(text)
    if rel.endswith(".md"):
        text = text.replace(
            "The only external stylesheet allowed is Google Fonts.",
            "No external stylesheet is allowed in this offline kit.",
        )
        text = re.sub(
            r"python3 scripts/(verify-[A-Za-z0-9_-]+|test-verify-[A-Za-z0-9_-]+|lint-[A-Za-z0-9_-]+)\.py[^\n`]*",
            "Upstream maintainer check unavailable in this kit; use packaged offline self_check.py",
            text,
        )
    if rel == "scripts/export_svg.py":
        # The implementation is deliberately internal. Its CLI would bypass the
        # guard, so refuse direct execution and let the guard call the function.
        text = text.replace("sys.exit(main())", 'sys.exit("Use export_diagram.py; direct SVG export is disabled")')
    if rel in TEMPLATES:
        text = re.sub(r"<link\b[^>]*fonts\.googleapis\.com[^>]*>\s*", "", text)
    if rel.endswith(".md"):
        # Omitted galleries/examples remain citations, not missing local links or
        # permission to download/run anything. Runtime helper names route locally.
        text = text.replace("scripts/export_svg.py", "scripts/export_diagram.py")
        text = text.replace("scripts/export_png.py", "scripts/export_diagram.py")

        def link(match: re.Match[str]) -> str:
            label, target = match.group(1), match.group(2)
            if ":" in target or target.startswith("#"):
                return match.group(0)
            path, _, anchor = target.partition("#")
            candidate = Path(rel).parent / path
            parts: list[str] = []
            for part in candidate.parts:
                if part == "..":
                    if parts:
                        parts.pop()
                elif part != ".":
                    parts.append(part)
            normalized = "/".join(parts)
            if normalized in selected_paths:
                return match.group(0)
            url = f"https://github.com/{UPSTREAM}/blob/{PIN}/{PREFIX}{normalized}"
            return f"[{label}]({url}{'#' + anchor if anchor else ''})"

        text = re.sub(r"\[([^\]]+)\]\(([^ )]+)\)", link, text)
    return text


def build(source: Path | None) -> dict[str, bytes]:
    tree = json.loads(fetch(f"https://api.github.com/repos/{UPSTREAM}/git/trees/{PIN}?recursive=1", 4_000_000))
    if tree.get("truncated"):
        raise ValueError("Git tree is truncated")
    entries = {e["path"]: e for e in tree["tree"] if e["type"] == "blob"}
    paths = sorted(p[len(PREFIX) :] for p in entries if p.startswith(PREFIX) and selected(p[len(PREFIX) :]))
    if len(paths) != 77:
        raise ValueError(f"selected inventory changed: expected 77, found {len(paths)}")
    local = KIT / "vendor/diagram-design-local"
    local_paths = {p.relative_to(local).as_posix() for p in local.rglob("*") if p.is_file()}
    installed_paths = (
        (set(paths) - OVERRIDES - {"scripts/export_svg.py"}) | local_paths | {"scripts/upstream_export_svg.py"}
    )
    output: dict[str, bytes] = {}
    source_hashes: dict[str, str] = {}
    total = 0
    for upstream in ["LICENSE", *[PREFIX + p for p in paths]]:
        entry = entries[upstream]
        if entry["mode"] not in {"100644", "100755"} or entry.get("size", 0) > 1_000_000:
            raise ValueError(f"unsafe source entry: {upstream}")
        data = (
            (source / upstream).read_bytes()
            if source
            else fetch(f"https://raw.githubusercontent.com/{UPSTREAM}/{PIN}/{upstream}", 1_000_000)
        )
        # Git object identity, not cryptographic authentication; SHA-256 also recorded.
        blob = hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data, usedforsecurity=False).hexdigest()
        if blob != entry["sha"]:
            raise ValueError(f"source does not match pinned Git blob: {upstream}")
        total += len(data)
        if total > 3_000_000 or b"\0" in data:
            raise ValueError("source text exceeds bounds or contains NUL")
        text = data.decode("utf-8")
        source_hashes[upstream] = digest(data)
        if upstream == "LICENSE":
            output[LICENSE] = data
            continue
        rel = upstream[len(PREFIX) :]
        if rel in OVERRIDES:
            continue
        target = "scripts/upstream_export_svg.py" if rel == "scripts/export_svg.py" else rel
        output[PAYLOAD + target] = adapt(rel, text, installed_paths).encode()
    for rel in sorted(local_paths):
        path = local / rel
        if path.is_symlink() or not re.fullmatch(r"[A-Za-z0-9._/-]+", rel):
            raise ValueError("unsafe local adaptation")
        output[PAYLOAD + rel] = path.read_bytes()
    lock = {
        "upstream": UPSTREAM,
        "ref": PIN,
        "upstreamVersion": "2.6.153",
        "license": "MIT",
        "thirdParty": [
            {
                "author": "Cathryn Lavery",
                "copyright": "Copyright (c) 2025 Cathryn Lavery",
                "licenseFile": LICENSE,
                "licenseSha256": digest(output[LICENSE]),
            }
        ],
        "sourceSha256": source_hashes,
        "localChanges": [
            "Offline/system fonts",
            "Project-local branding",
            "Guarded export only",
            "No galleries, logos, fonts, examples or maintainer tooling",
            "Pinned source links for omitted references",
        ],
        "files": {p: digest(data) for p, data in sorted(output.items())},
    }
    output[LOCK] = (json.dumps(lock, indent=2, sort_keys=True) + "\n").encode()
    spec = (KIT / "spec.yaml").read_text()
    block = "\n".join(
        [
            BEGIN,
            *[
                line
                for p in sorted(lock["files"])
                for line in (f"  - path: /home/agent/{p[len('files/home/') :]}", '    mode: "0644"', f"    source: {p}")
            ],
            END,
        ]
    )
    if BEGIN in spec:
        a, b = spec.index(BEGIN), spec.index(END) + len(END)
        spec = spec[:a] + block + spec[b:]
    else:
        spec = spec.replace("commands:\n", block + "\n\ncommands:\n", 1)
        if BEGIN not in spec:
            raise ValueError("spec commands anchor missing")
    output["spec.yaml"] = spec.encode()
    return output


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-dir", type=Path)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        output = build(args.source_dir)
        old = json.loads((KIT / LOCK).read_text())["files"] if (KIT / LOCK).exists() else {}
        stale = set(old) - set(output)
        if stale:
            raise ValueError(f"explicit removal review needed for stale payload files: {sorted(stale)}")
        for rel, data in output.items():
            target = KIT / rel
            if any(p.is_symlink() for p in [target, *target.parents]):
                raise ValueError(f"symlink destination refused: {rel}")
            if args.check:
                if not target.is_file() or target.read_bytes() != data:
                    raise ValueError(f"generated content differs: {rel}")
            else:
                if target.exists() and rel not in old and rel not in {LOCK, "spec.yaml"}:
                    raise ValueError(f"unowned destination refused: {rel}")
        if not args.check:
            for rel, data in output.items():
                target = KIT / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(data)
                target.chmod(0o644)
        print(f"{'Verified' if args.check else 'Generated'} Diagram Design at {PIN}")
        return 0
    except (OSError, ValueError, KeyError) as error:
        print(f"vendor-diagram-design: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
