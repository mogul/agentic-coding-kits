#!/usr/bin/env python3
"""Generate the offline Diagram Design payload from a verified, pinned source tree.

Host-side only. Copies no binaries, fonts, logos, marketplace or maintainer code.
Local adaptations live in vendor/diagram-design-local, never in generated files/.
Acquisition uses public GitHub GETs with no credential headers. --source-dir uses
an already downloaded tree, but still verifies every selected file's Git blob ID.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
import urllib.request
from pathlib import Path

KIT = Path(__file__).resolve().parents[1]
UPSTREAM = "cathrynlavery/diagram-design"
PIN = "f2496acbde9f45ccb55c24d4f75210c8a1355df8"
PREFIX = "skills/diagram-design/"
PAYLOAD = "files/home/.agents/skills/diagram-design/"
LICENSE = "files/home/.agents/licenses/diagram-design-LICENSE"
LOCK = "vendor/diagram-design.json"
BEGIN = "  # BEGIN vendored:diagram-design (generated by scripts/vendor-diagram-design; do not edit)"
END = "  # END vendored:diagram-design"
OVERRIDES = {
    "references/onboarding.md",
