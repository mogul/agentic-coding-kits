#!/usr/bin/env bash
#
# verify — host-side offline gate for the personal acq mixin kit.
#
# Checks that the spec and the payload under files/ agree, that the skill is
# well-formed, that the helper scripts parse, that the Paseo plugin installer is
# pinned and wired, and that nothing credential-shaped is shipped. If `acq kit
# validate` is available, the neutral hybrid/v1 spec is validated too. There is
# no live sandbox check: a live run would exercise acq and the paseo kit.
#
# Usage (from anywhere): path/to/personal/scripts/verify

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SPEC="$KIT_DIR/spec.yaml"
SKILL_NAME="paseo-first-mate"
SKILL_DIR="$KIT_DIR/files/home/.agents/skills/$SKILL_NAME"
SKILL_MD="$SKILL_DIR/SKILL.md"
CHECK_PY="$SKILL_DIR/assets/first-mate-check.py"
WAIT_SH="$SKILL_DIR/assets/first-mate-wait.sh"
PLUGINS_SH="$KIT_DIR/files/home/paseo-plugins-install.sh"
PYTHON_BIN="${PYTHON_BIN:-python3}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/personal-verify.XXXXXX")" || { echo "mktemp failed" >&2; exit 1; }

pass=0
fail=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
skip() { printf '  \033[33mSKIP\033[0m %s\n' "$1"; }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

trap 'rm -rf "$WORK" >/dev/null 2>&1 || true' EXIT INT TERM

info "0. Preconditions"
for f in "$SPEC" "$SKILL_MD" "$CHECK_PY" "$WAIT_SH" "$PLUGINS_SH"; do
  if [ -f "$f" ]; then
    ok "present: ${f#"$KIT_DIR"/}"
  else
    bad "missing: ${f#"$KIT_DIR"/}"
  fi
done
if [ "$fail" -ne 0 ]; then
  printf '\n  %d passed, %d failed\n' "$pass" "$fail"
  exit 1
fi

info "1. Spec and payload agree"
# Every files[].source must exist, and every file under files/ must be listed:
# msb materializes only the listed records, so an unlisted file is silently
# missing in one backend and present in the other.
listed="$WORK/listed.txt"
actual="$WORK/actual.txt"
awk '/^files:/ {f=1; next} /^[A-Za-z]/ {f=0} f && /^[[:space:]]+source:[[:space:]]/ {sub(/^[[:space:]]+source:[[:space:]]+/, ""); print}' "$SPEC" | LC_ALL=C sort > "$listed"
(cd "$KIT_DIR" && find files -type f | LC_ALL=C sort) > "$actual"
if diff -u "$listed" "$actual" >"$WORK/diff.log" 2>&1; then
  ok "files[].source entries match every file under files/ ($(wc -l < "$listed" | tr -d ' ') files)"
else
  bad "spec files[] and files/ tree differ (- listed, + on disk)"
  sed 's/^/  | /' "$WORK/diff.log" >&2
fi
while IFS= read -r src; do
  [ -f "$KIT_DIR/$src" ] || bad "source does not exist: $src"
done < "$listed"

info "2. Declared modes are right and the scripts are executable on disk"
for pair in "SKILL.md:0644" "assets/first-mate-check.py:0755" "assets/first-mate-wait.sh:0755"; do
  rel="${pair%%:*}"
  want="${pair##*:}"
  guest="/home/agent/.agents/skills/$SKILL_NAME/$rel"
  got="$(awk -v p="$guest" '$0 == "  - path: " p {f=1; next} f && /mode:/ {gsub(/"/,"",$2); print $2; exit}' "$SPEC")"
  if [ "$got" = "$want" ]; then
    ok "$rel mode $want"
  else
    bad "$rel: spec mode '${got:-<none>}', expected $want"
  fi
done
for script in "$CHECK_PY" "$WAIT_SH"; do
  if [ -x "$script" ]; then
    ok "${script#"$KIT_DIR"/} is executable on disk"
  else
    bad "${script#"$KIT_DIR"/} lost its executable bit"
  fi
done

info "3. Skill frontmatter"
fm_name="$(awk 'NR==1 && $0=="---" {f=1; next} f && $0=="---" {exit} f && /^name:/ {sub(/^name:[[:space:]]*/,""); gsub(/"/,""); print; exit}' "$SKILL_MD")"
if [ "$fm_name" = "$SKILL_NAME" ]; then
  ok "SKILL.md name matches its directory ($SKILL_NAME)"
else
  bad "SKILL.md name '${fm_name:-<none>}' does not match directory '$SKILL_NAME'"
fi
if [ "$(head -n 1 "$SKILL_MD")" = "---" ] && awk 'NR>1 && $0=="---" {found=1} END {exit !found}' "$SKILL_MD"; then
  ok "SKILL.md has a closed frontmatter block"
else
  bad "SKILL.md frontmatter is not delimited by ---"
fi
for asset in first-mate-check.py first-mate-wait.sh; do
  if grep -q "assets/$asset" "$SKILL_MD"; then
    ok "SKILL.md references assets/$asset"
  else
    bad "SKILL.md does not reference assets/$asset"
  fi
done

info "3b. Vendored Pocock skills match their lock file"
# vendor/mattpocock-skills.json pins the upstream commit and a sha256 per shipped
# file. The set of vendored files must equal the lock's, byte for byte, so a
# hand edit or a half-run of the vendoring script cannot pass.
LOCK="$KIT_DIR/vendor/mattpocock-skills.json"
if [ ! -f "$LOCK" ]; then
  bad "vendor/mattpocock-skills.json missing"
elif command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  if "$PYTHON_BIN" - "$KIT_DIR" "$LOCK" >"$WORK/vendor.log" 2>&1 <<'PY'
import hashlib, json, os, re, sys
kit, lock_path = sys.argv[1], sys.argv[2]
lock = json.load(open(lock_path, encoding="utf-8"))
errors = []
if not re.fullmatch(r"[0-9a-f]{40}", lock.get("ref", "")):
    errors.append("lock ref is not a full commit SHA")
locked = lock["files"]
for rel, digest in sorted(locked.items()):
    path = os.path.join(kit, rel)
    if not os.path.isfile(path):
        errors.append("missing: " + rel)
    elif hashlib.sha256(open(path, "rb").read()).hexdigest() != digest:
        errors.append("differs from lock: " + rel)
own = ("files/home/.agents/skills/paseo-first-mate/", "files/home/paseo-plugins-install.sh")
for item in lock.get("thirdParty", []):
    path = os.path.join(kit, item["licenseFile"])
    if not os.path.isfile(path):
        errors.append("missing third-party licence: " + item["licenseFile"])
    elif hashlib.sha256(open(path, "rb").read()).hexdigest() != item["licenseSha256"]:
        errors.append("third-party licence differs from its pin: " + item["licenseFile"])
third = {item["licenseFile"] for item in lock.get("thirdParty", [])}
on_disk = set()
for root, _, names in os.walk(os.path.join(kit, "files")):
    for name in names:
        rel = os.path.relpath(os.path.join(root, name), kit).replace(os.sep, "/")
        if not rel.startswith(own) and rel not in third:
            on_disk.add(rel)
for rel in sorted(on_disk - set(locked)):
    errors.append("not in lock: " + rel)
print("\n".join(errors))
sys.exit(1 if errors else 0)
PY
  then
    ok "every vendored file matches vendor/mattpocock-skills.json ($(grep -c '"files/' "$LOCK") files)"
  else
    bad "vendored files and vendor/mattpocock-skills.json disagree"
    sed 's/^/  | /' "$WORK/vendor.log" >&2
  fi
else
  skip "$PYTHON_BIN not installed"
fi

info "3b2. Vendored spec records mirror their source and are declared 0644"
# The generated block holds only plain 0644 records whose guest path is the source
# path under /home/agent. A hand edit to a mode or path cannot pass.
if awk '
  /BEGIN vendored:/ {v=1; seen_begin=1; next}
  /END vendored:/ {v=0; seen_end=1}
  v && /^  - path:/ {sub(/^  - path: /, ""); p=$0; m=""; next}
  v && /^    mode:/ {gsub(/"/, ""); m=$2; next}
  v && /^    source:/ {s=$2; want="/home/agent/" substr(s, length("files/home/")+1);
    if (m != "0644" || p != want) {print "bad record: " p " mode=" m " source=" s; bad=1}}
  END {if (!seen_begin || !seen_end) {print "vendored block markers not found"; bad=1}; exit bad}' "$SPEC" >"$WORK/block.log" 2>&1; then
  ok "every vendored spec record is mode 0644 and mirrors its source path"
else
  bad "vendored spec block was edited by hand"
  sed 's/^/  | /' "$WORK/block.log" >&2
fi

info "3b3. Credit is shipped with the copies"
# NOTICE, both licences in the spec at mode 0644, and the credit file the pr skill carries.
credit_bad=0
for f in NOTICE docs/vendored-skills.md files/home/.agents/licenses/mattpocock-skills-LICENSE files/home/.agents/licenses/humanlayer-skills-LICENSE files/home/.agents/skills/pr/CREDITS.md; do
  [ -s "$KIT_DIR/$f" ] || { bad "missing credit file: $f"; credit_bad=1; }
done
for lic in mattpocock-skills-LICENSE humanlayer-skills-LICENSE; do
  rec="$(awk -v p="/home/agent/.agents/licenses/$lic" '$0 == "  - path: " p {f=1; next} f && /mode:/ {gsub(/"/,"",$2); print $2; exit}' "$SPEC")"
  [ "$rec" = "0644" ] || { bad "spec record for $lic is missing or not mode 0644 (got '${rec:-<none>}')"; credit_bad=1; }
done
for who in "Matt Pocock" "Dex Horthy"; do
  grep -q "$who" "$KIT_DIR/NOTICE" 2>/dev/null || { bad "NOTICE does not name $who"; credit_bad=1; }
done
grep -q "^Copyright (c) 2026 Matt Pocock" "$KIT_DIR/files/home/.agents/licenses/mattpocock-skills-LICENSE" 2>/dev/null || { bad "Pocock licence file lacks its copyright line"; credit_bad=1; }
grep -q "^Copyright (c) 2026 HumanLayer" "$KIT_DIR/files/home/.agents/licenses/humanlayer-skills-LICENSE" 2>/dev/null || { bad "HumanLayer licence file lacks its copyright line"; credit_bad=1; }
[ "$credit_bad" -eq 0 ] && ok "NOTICE, both licences (spec mode 0644), and the pr credit file are present"

info "3c. Vendored skills are well-formed and the code-review rename is consistent"
SKILLS_ROOT="$KIT_DIR/files/home/.agents/skills"
rename_bad=0
for dir in "$SKILLS_ROOT"/*/; do
  name="$(basename "$dir")"
  [ "$name" = "paseo-first-mate" ] && continue
  fm="$(awk 'NR==1 && $0=="---" {f=1; next} f && $0=="---" {exit} f && /^name:/ {sub(/^name:[[:space:]]*/,""); gsub(/"/,""); print; exit}' "$dir/SKILL.md" 2>/dev/null)"
  if [ "$fm" != "$name" ]; then
    bad "skill directory '$name' has SKILL.md name '${fm:-<none>}'"
    rename_bad=1
  fi
done
[ "$rename_bad" -eq 0 ] && ok "every vendored SKILL.md name matches its directory"
if [ -d "$SKILLS_ROOT/code-review" ]; then
  bad "a vendored skill is installed as plain code-review; the playbook kit owns that name"
else
  ok "no vendored skill is installed as code-review"
fi
leftover="$(grep -rnE '(^|[^A-Za-z0-9_-])code-review([^A-Za-z0-9_-]|$)' "$SKILLS_ROOT" --exclude-dir=paseo-first-mate 2>/dev/null || true)"
if [ -z "$leftover" ]; then
  ok "no bare code-review reference in vendored skills"
else
  bad "bare code-review reference left in a vendored skill"
  printf '%s\n' "$leftover" | sed 's/^/  | /' >&2
fi

info "3d. Paseo plugin installer is wired and pinned"
# The installer enforces pins at run time (install_plugin refuses anything but a
# git source with a full 40-hex commit or an npm source with an exact version).
# This section checks that the guard is still there, that nothing bypasses it, and
# that every listed call is pinned. See docs/decisions/0003.
plug_bad=0
spec_commands="$(awk '/^commands:/ {c=1; next} /^[A-Za-z]/ {c=0} c' "$SPEC" | grep -vE '^[[:space:]]*#')"
spec_caps="$(awk '/^caps:/ {c=1; next} /^[A-Za-z]/ {c=0} c' "$SPEC" | grep -vE '^[[:space:]]*#')"
rec="$(awk -v p="/home/agent/paseo-plugins-install.sh" '$0 == "  - path: " p {f=1; next} f && /mode:/ {gsub(/"/,"",$2); print $2; exit}' "$SPEC")"
[ "$rec" = "0755" ] || { bad "spec record for paseo-plugins-install.sh is missing or not mode 0755 (got '${rec:-<none>}')"; plug_bad=1; }
[ -x "$PLUGINS_SH" ] || { bad "paseo-plugins-install.sh lost its executable bit"; plug_bad=1; }
printf '%s\n' "$spec_commands" | grep -q 'sh /home/agent/paseo-plugins-install.sh' || { bad "no startup command runs paseo-plugins-install.sh"; plug_bad=1; }
printf '%s\n' "$spec_commands" | grep -qE '^[[:space:]]+background:[[:space:]]+true[[:space:]]*$' || { bad "the plugin startup command is not background: true"; plug_bad=1; }
printf '%s\n' "$spec_caps" | grep -qE '^[[:space:]]+-[[:space:]]+github\.com[[:space:]]*$' || { bad "caps.network.allow does not list github.com"; plug_bad=1; }
if grep -qE '^[[:space:]]*install_plugin[[:space:]]+[a-z][a-z0-9-]*[[:space:]]+npm:' "$PLUGINS_SH"; then
  printf '%s\n' "$spec_caps" | grep -qE '^[[:space:]]+-[[:space:]]+registry\.npmjs\.org[[:space:]]*$' || { bad "an npm-sourced plugin is listed but caps.network.allow lacks registry.npmjs.org"; plug_bad=1; }
fi
# The run-time guard must be present.
for needle in "*[!0-9a-f]*|\"\")" '"${#pin}" -eq 40' '*[!0-9.]*|*..*|.*|*.)' 'REFUSED: source must be git:owner/repo or npm:package'; do
  grep -qF -- "$needle" "$PLUGINS_SH" || { bad "install_plugin guard missing: $needle"; plug_bad=1; }
done
# Only install_plugin may call `paseo plugin install`, and only with the checked $target and --ref "$pin".
installs="$(grep -nE 'paseo[[:space:]]+plugin[[:space:]]+(install|add)' "$PLUGINS_SH" | grep -vE '^[0-9]+:[[:space:]]*#' || true)"
if [ "$(printf '%s\n' "$installs" | grep -c .)" -ne 2 ] \
  || [ "$(printf '%s\n' "$installs" | grep -cF -- '--ref "$pin" "$target" >>')" -ne 1 ] \
  || [ "$(printf '%s\n' "$installs" | grep -cF -- '--id "$id" "$target" >>')" -ne 1 ]; then
  bad "paseo plugin install appears outside install_plugin or with an unchecked target"
  printf '%s\n' "$installs" | sed 's/^/  | /' >&2
  plug_bad=1
fi
# Every call must be pinned. Calls are only accepted at the start of a line.
calls="$(grep -E '^[[:space:]]*install_plugin[[:space:]]' "$PLUGINS_SH" | grep -vE 'install_plugin\(\)' || true)"
other="$(grep -E 'install_plugin' "$PLUGINS_SH" | grep -vE '^[[:space:]]*(#|install_plugin[[:space:]]|install_plugin\(\))' | grep -vE 'REFUSED|^[[:space:]]*#' || true)"
if [ -n "$other" ]; then
  bad "install_plugin is referenced somewhere other than a line-leading call"
  printf '%s\n' "$other" | sed 's/^/  | /' >&2
  plug_bad=1
fi
if [ -z "$calls" ]; then
  bad "paseo-plugins-install.sh installs no plugins"; plug_bad=1
fi
while IFS= read -r line; do
  [ -n "$line" ] || continue
  # shellcheck disable=SC2086
  set -- $line
  src="${3:-}"; pin="${4:-}"; extra="${5:-}"
  [ -z "$extra" ] || { bad "unexpected extra arguments: $line"; plug_bad=1; continue; }
  case "$src" in
    git:*) printf '%s' "${src#git:}" | grep -qE '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || { bad "git source must be git:owner/repo: $line"; plug_bad=1; }
       printf '%s' "$pin" | grep -qE '^[0-9a-f]{40}$' || { bad "not pinned to a full commit SHA: $line"; plug_bad=1; } ;;
    npm:*) printf '%s' "${src#npm:}" | grep -qE '^(@[a-z0-9._-]+/)?[a-z0-9._-]+$' || { bad "npm source must be npm:package with no version or tag: $line"; plug_bad=1; }
       printf '%s' "$pin" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || { bad "npm source not pinned to an exact version: $line"; plug_bad=1; } ;;
    *) bad "source must be git:owner/repo or npm:package: $line"; plug_bad=1 ;;
  esac
done <<EOF_CALLS
$calls
EOF_CALLS
[ "$plug_bad" -eq 0 ] && ok "installer is mode 0755, wired to a background startup command, github.com (and registry.npmjs.org for npm sources) allow-listed, guarded at run time, and every plugin is pinned"

info "4. Helper scripts parse"
if command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  if "$PYTHON_BIN" -c 'import ast,sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' "$CHECK_PY" 2>"$WORK/py.log"; then
    ok "first-mate-check.py parses as Python 3"
  else
    bad "first-mate-check.py has a syntax error"
    sed 's/^/  | /' "$WORK/py.log" >&2
  fi
else
  skip "$PYTHON_BIN not installed"
fi
if bash -n "$WAIT_SH" 2>"$WORK/sh.log"; then
  ok "first-mate-wait.sh parses as bash"
else
  bad "first-mate-wait.sh has a syntax error"
  sed 's/^/  | /' "$WORK/sh.log" >&2
fi
if sh -n "$PLUGINS_SH" 2>"$WORK/plugins-sh.log"; then
  ok "paseo-plugins-install.sh parses as POSIX sh"
else
  bad "paseo-plugins-install.sh has a syntax error"
  sed 's/^/  | /' "$WORK/plugins-sh.log" >&2
fi
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck --severity=warning "$WAIT_SH" "$PLUGINS_SH" "$0" "$KIT_DIR/scripts/test-wait-lock" >"$WORK/shellcheck.log" 2>&1; then
    ok "shellcheck --severity=warning passes"
  else
    bad "shellcheck --severity=warning failed"
    sed 's/^/  | /' "$WORK/shellcheck.log" >&2
  fi
else
  skip "shellcheck not installed (install it to run this gate)"
fi

info "4b. Wait loop locking and ownership"
# One loop per FIRST_MATE_DIR, keyed on the owner. Uses a stub detector, so it
# needs no gh, paseo, or network. Skips itself when flock is missing.
if command -v flock >/dev/null 2>&1; then
  if bash "$KIT_DIR/scripts/test-wait-lock" >"$WORK/waitlock.log" 2>&1; then
    ok "first-mate-wait.sh locking and ownership test passes"
  else
    bad "first-mate-wait.sh locking and ownership test failed"
    sed 's/^/  | /' "$WORK/waitlock.log" >&2
  fi
else
  skip "flock not installed (wait-loop locking test not run)"
fi

info "5. Shipped detector has no baked-in watch targets"
# `list` prints the watch list without calling GitHub or Paseo. It must come
# back with no PRs, issues, or releases, so nothing is hard-coded to a repo.
if command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  mkdir -p "$WORK/state"
  if FIRST_MATE_DIR="$WORK/state" "$PYTHON_BIN" "$CHECK_PY" list >"$WORK/list.out" 2>"$WORK/list.err" \
    && "$PYTHON_BIN" -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if not (d.get("repos") or d.get("prs") or d.get("issues") or d.get("releases") or d.get("branches") or d.get("workflows")) else 1)' "$WORK/list.out"; then
    ok "first-mate-check.py ships with an empty watch list"
  else
    bad "first-mate-check.py list failed or returned a non-empty watch list"
    sed 's/^/  | /' "$WORK/list.err" >&2
  fi
else
  skip "$PYTHON_BIN not installed"
fi

info "6. No credential-shaped content"
# Names of variables may appear in prose; values must not.
scan_rc=0
grep -rEn \
  -e 'gh[pousr]_[A-Za-z0-9]{20,}' \
  -e 'github_pat_[A-Za-z0-9_]{20,}' \
  -e 'sk-[A-Za-z0-9]{20,}' \
  -e 'AKIA[0-9A-Z]{16}' \
  -e 'BEGIN [A-Z ]*PRIVATE KEY' \
  "$KIT_DIR" --exclude=verify >"$WORK/secrets.log" 2>&1 || scan_rc=$?
case "$scan_rc" in
  1) ok "no token, key, or private-key patterns in the kit (payload and docs)" ;;
  0) bad "credential-shaped string found"; sed 's/^/  | /' "$WORK/secrets.log" >&2 ;;
  *) bad "credential scan could not run (grep exit $scan_rc)"; sed 's/^/  | /' "$WORK/secrets.log" >&2 ;;
esac

info "7. acq neutral-spec validation (optional)"
if command -v acq >/dev/null 2>&1; then
  if acq kit validate "$KIT_DIR" >"$WORK/kit-validate.log" 2>&1; then
    ok "acq kit validate accepts the hybrid/v1 spec"
  else
    bad "acq kit validate rejected the spec"
    sed 's/^/  | /' "$WORK/kit-validate.log" >&2
  fi
else
  skip "acq kit validate not available"
fi

info "Summary"
printf '  %d passed, %d failed\n' "$pass" "$fail"
if [ "$fail" -eq 0 ]; then
  printf '  \033[32mOffline gate passed.\033[0m\n'
  exit 0
fi
printf '  \033[31mOffline gate failed — see above.\033[0m\n'
exit 1
